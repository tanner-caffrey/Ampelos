# Ampelos Environment Configuration

# =============================================================================
# Letta Configuration
# Ampelos supports BOTH cloud and self-hosted Letta backends simultaneously.
# Configure one or both depending on your deployment.
# =============================================================================

# Self-Hosted Letta Server
# Base URL for the self-hosted Letta server
LETTA_SERVER_URL=http://localhost:8283

# Authentication token for self-hosted server (optional)
LETTA_TOKEN=

# Letta Cloud
# API key for Letta Cloud (get from https://app.letta.com)
LETTA_CLOUD_API_KEY=

# Project ID for Letta Cloud (found in project settings)
LETTA_CLOUD_PROJECT_ID=

# =============================================================================
# MCP Server Configuration
# =============================================================================
# API key for MCP server authentication (required for production)
# Clients must include this in Authorization header: Bearer <MCP_API_KEY>
MCP_API_KEY=

# Transport mode: 'http' or 'stdio' (default: http)
MCP_TRANSPORT_MODE=http

# HTTP port for MCP server (default: 3005)
MCP_HTTP_PORT=3005

# CORS allowed origins (comma-separated, leave empty for same-origin only)
# Example: MCP_CORS_ORIGIN=http://localhost:3000,http://localhost:5173
MCP_CORS_ORIGIN=

# =============================================================================
# Module-Specific Configuration
# =============================================================================

# Bluesky Integration (optional)
# Add app passwords for each agent that uses the Bluesky module
# Get app passwords from: https://bsky.app/settings/app-passwords
# Format: BLUESKY_<AGENTNAME>_PASSWORD=<app-password>
# Example:
# BLUESKY_MYAGENT_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Push Notifications (optional)
# Generate VAPID keys with: npx web-push generate-vapid-keys
# These enable PWA push notifications so agents can notify users
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

