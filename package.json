{
  "name": "ampelos",
  "version": "0.1.0",
  "description": "Modular MCP Service Framework for Letta Agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ampelos": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "mkdir -p dist/core/letta/templates/memory_blocks dist/core/letta/templates/system_prompts dist/core/letta/templates/agents && cp -r src/core/letta/templates/memory_blocks/*.txt dist/core/letta/templates/memory_blocks/ && cp -r src/core/letta/templates/system_prompts/*.txt dist/core/letta/templates/system_prompts/ && cp -r src/core/letta/templates/agents/*.json dist/core/letta/templates/agents/",
    "dev": "tsx src/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run web:dev\" --names \"server,web\" --prefix-colors \"blue,green\"",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "web:install": "cd src/modules/chat-web/web && npm install",
    "web:build": "cd src/modules/chat-web/web && npm run build",
    "web:dev": "cd src/modules/chat-web/web && npm run dev",
    "web:setup": "npm run web:install && npm run web:build",
    "dev:all:build": "npm run web:build && npm run dev:all",
    "migrate": "tsx scripts/migrate-to-sqlite.ts",
    "migrate:dry-run": "tsx scripts/migrate-to-sqlite.ts --dry-run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "letta",
    "agent",
    "framework"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@atproto/api": "^0.18.6",
    "@letta-ai/letta-client": "1.0.0-alpha.20",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/dockerode": "^3.3.46",
    "better-sqlite3": "^12.5.0",
    "dockerode": "^4.0.9",
    "dotenv": "^17.2.3",
    "lowdb": "^7.0.1",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.25",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.0.15",
    "concurrently": "^9.2.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
